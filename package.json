{
  "name": "agnes2api",
  "version": "0.4.0",
  "description": "AI gateway that speaks the OpenAI, Anthropic, OpenAI Responses and Google Gemini protocols over one shared upstream pool, with a built-in admin panel. Ships as a single Docker image.",
  "type": "module",
  "license": "MIT",
  "author": "xwteam",
  "homepage": "https://github.com/xwteam/agnes2api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xwteam/agnes2api.git"
  },
  "bugs": {
    "url": "https://github.com/xwteam/agnes2api/issues"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "ui:build": "node scripts/build-ui.mjs",
    "dev:node": "node scripts/build-ui.mjs && pnpm build && node dist/entry/node.js",
    "check:ui": "node scripts/check-ui-budget.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:refs": "node scripts/check-comment-refs.mjs"
  },
  "keywords": [
    "ai-gateway",
    "openai",
    "anthropic",
    "responses",
    "gemini",
    "docker",
    "hono",
    "llm-proxy"
  ],
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.2"
  },
  "devDependencies": {
    "@types/node": "22",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
