# agnes2api 环境变量示例。用法：cp .env.example .env
#
# 这份文件列出网关认得的**每一个**环境变量。**注释详略不一**：多数变量只有一行，
# 而踩过坑的那几个（key 池配额、面板口令、用量统计……）在这里就写满了十几行的代价与算式。
# 成体系的取值范围与「默认值是怎么算出来的」看 docs/<你的语言>/DEPLOY.md 的
# 「环境变量」一节（注册机那一组另见同目录的 REGISTRAR.md）。
#
# ⚠️ **留空不等于「没设」**：`FOO=` 传进去的是**空字符串**而不是「未设置」，而 Number("") = 0。
# 数值型的那几行因此**别留空**——轻则把一个旋钮悄悄变成 0（两个 POOL_ 开头的旋钮就是这一族：
# 0 对它们是合法的「关闭」，没有任何东西会拦你），重则过不了「不小于 1 的整数」那一关、
# 全新部署直接起不来。不想设某个数值项，就把那一行整行删掉或注释掉
#（末尾的 USAGE_FLUSH_INTERVAL_MS 就是这么写的）。
# 非数值项留空是安全的：本文件里有意留空的那几行（凭据、口令、开关）代码一律当「没设」处理，
# PORT / DATA_DIR 的空串也在 src/entry/node.ts 里被归一成「没设」。
#
# ⚠️ **DATA_DIR 与卷挂载：Docker 形态下这一行不是一个可以自由改的旋钮。**
# 归一成「没设」的只有**空串**这一种。写成 `DATA_DIR=/app/store` 这类**非空、但容器里
# 底下没挂任何卷**的值，一路上不会有任何东西拦你：容器起得来、/health 回 ok、面板与
# key 池一切正常、注册机照常补池 —— 而 store.json 落在**容器可写层**里。
# docker-compose.yml 挂的是写死的 `./data:/app/data`，`.env` 里的 DATA_DIR 完全不参与
# 那一行的插值，所以改了这里而不改那里 = 数据没落在卷上。**几周之后照文档执行
# `docker compose pull && docker compose up -d` 升级，容器一重建，整池 key、已签发的
# 对外 API 密钥、面板配置一起消失，而你一直在备份的 ./data 从头到尾是空的。**
# ⇒ Docker 形态下要换数据落在宿主哪儿，改的是那行挂载的**左半边**（`./data`），
#   这一行不动；真要改右半边，就把这一行改成同一个路径。两边必须一起改。
# 容器启动时 entrypoint 会检查这件事：DATA_DIR 没落在任何挂载点上时，日志里有一条
# 「没有落在任何挂载点上」的警告 —— 那是这条失效链上唯一的信号，/health 不报数据落在哪儿。
# 完整说明见 docs/<你的语言>/DEPLOY.md 的「Docker 部署」一节。

# 网关口令（必填）。客户端用它调用本网关。
GATEWAY_TOKEN=

# 逃生口。置 1 时启动**完全忽略**存储里的 config 键（只忽略，不删除），
# 只用环境变量与内置默认值。存储里的配置被写坏到网关起不来时用它救回来，
# 救回之后记得去掉这一行，否则面板里的配置永远不会生效。
RESET_CONFIG=

# Agnes 上游基址
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# 流式响应与视频轮询的上游首字节超时（毫秒）
UPSTREAM_TIMEOUT_MS=8000

# 同步端点的整体超时预算（毫秒）：图片生成、视频建任务，以及所有非流式对话。
# 这类请求要等上游把整个结果算完才有首字节，8 秒的快档不适用。
# 它是一次请求的总预算（客户端最坏就等这么久），其中单把 key 最多用掉一半，
# 剩下的留给换 key 重试，因此请设成「单次调用最坏耗时的两倍以上」。
UPSTREAM_SYNC_TIMEOUT_MS=120000

# 瞬时故障（超时、网络错误、上游 5xx）累计上限，达到则进入长冷却
MAX_STRIKES=3

# 上游返回 429 后，对应 key 的冷却时长（毫秒）
COOLDOWN_RATE_LIMIT_MS=60000

# 上游返回 402 后，对应 key 的冷却时长（毫秒）
COOLDOWN_PAYMENT_MS=3600000

# 瞬时故障累计到上限后的冷却时长（毫秒），到期自动恢复。默认三十分钟
COOLDOWN_STRIKE_MS=1800000

# Node 部署时的监听端口
PORT=8080

# 文件存储写入 store.json 的目录（仅 Node/Docker，Worker 不使用该变量）。Docker 形态下别单独改它，见头部那段「DATA_DIR 与卷挂载」
DATA_DIR=/app/data

# ── key 池的读写配额（Cloudflare Worker + KV 免费档才需要关心）──────────────
# 每个 isolate/进程在内存里缓存一份 key 池快照，这个值是它的存活时长（毫秒）。
# 0 = 关闭缓存（每个请求都真读一次存储）。
#
# 每天的 KV 读取次数 **与请求数无关**，只取决于刷新频率：
#     读取/天 = 活跃 isolate 数 × [ (86400 / 本值秒数) × (1 + 池中 key 数)
#                                 + 2880 ]          ← 配置刷新，每 30 秒一次
#               + 48~96                             ← 每半小时一次的索引对账
# 中括号里第二项是配置持有者的，它吃的是同一个 100,000/天的读配额，别漏算。
#
# 默认值（本值 60 秒 + 20 把 key）下每个 isolate 每天 1440×21 + 2880 = 33,120 次，
# **3 个活跃 isolate 就用掉 99.5%**——默认值在推荐配置处已经临界，没有余量。
# 预期活跃 isolate 更多（流量分散到更多 Cloudflare 边缘节点）就要把本值调大：
# 20 把 key、5 个 isolate 需要约 120000。
#
# 代价：别的 isolate 判定的冷却/剔除，本 isolate 最多晚“本值 + 约 60 秒”才看到
# （后者是 KV 边缘缓存的默认 cacheTtl）。默认 60000 时上界约 120 秒。
# 而且不只是“看得晚”：陈旧快照上的任意一次调度写会把整条记录覆写回去，抹掉别的
# isolate 在这个窗口里刚写下的 evicted / cooldownUntil，那次判定要重新发生一遍。
# 改这个值要重启容器 / 等 isolate 回收才生效，面板改它不会立刻生效。
POOL_CACHE_TTL_MS=60000

# key 的「最后使用时间」最多多久落盘一次（毫秒）。0 = 每次成功请求都落盘。
# 它是纯展示字段，不参与调度；每次成功请求都为它写一次 KV 会把免费档的
# 1,000 次/天写配额直接吃光，进而连 key 的冷却与剔除都写不进去。
# 代价：面板「最后使用」的精度最粗到这个间隔（任何状态变更的落盘会顺带刷新它）。
# 注意每把 key **首次**被用到时一定会落一次盘，否则面板永远显示「从未使用」。
# 改这个值要重启容器 / 等 isolate 回收才生效，面板改它不会立刻生效。
POOL_TOUCH_INTERVAL_MS=21600000

# ── 注册机（默认关闭）────────────────────────────────────
# 打开后，可用 key 低于 TARGET_KEYS 时会自动注册 Agnes 账号补池。
# 批量注册与上游服务条款存在张力，是否启用请自行判断。
REGISTRAR_ENABLED=false

# 注册机用哪一条邮箱通道：yyds 或 moemail。**两条通道是二选一**，两者平级，
# 按你自己的情况挑一条。启用注册机时必填，没有默认值。
#
# 没有主备，也没有自动降级：选中的这条通道失败时，注册机不会改用另一条。
# 代价要知道：这条通道收不到验证码时，补池会零产出直到你自己来换通道。
#
# 必须把选中那条通道的凭据填齐，否则注册机本次不启动（转发、/health、面板照常，
# 网关不会因此起不来）。另一条通道的凭据可以先填好，随时切过去。
#
# 怎么挑：注册机靠「换域名」绕开上游对一次性邮箱域名的屏蔽，所以可用域名
# 越多越耐用。查一下你两边各有多少可用域名，多的那个更耐用。
#
# 旧名字：这一格从前叫 REGISTRAR_PRIMARY，旁边还有一个备通道变量。
# 旧的主通道名**长期保留为兼容别名**（优先级低于这里这个新名字，用到它时面板顶部
# 会有一条提示）；旧的备通道变量**不再参与选路**，但仍会被读一次，只为在面板上
# 点名告诉你「这条通道被丢掉了」。两个旧名字都不会让升级中的部署停跑。
REGISTRAR_CHANNEL=

TARGET_KEYS=20
MINT_BATCH=5
TEND_INTERVAL_MS=1800000
CODE_TIMEOUT_MS=120000

# 单轮内每次铸 key 之间随机间隔的下限 / 上限（毫秒）
#
# ⚠️ 这两个数从 2000 / 5000 改成了 60000 / 90000。下限是实测出来的：同一个出口
# 在 60 秒以上的间隔下能连着发码成功，而无间隔连发时第三次就会被上游前置的限流挡下，
# 惩罚窗口按十几分钟计，而且窗口内每打一次就把窗口续一次。
# 上限只是抖动余量（多副本 / 多 isolate 同时起轮时别锁成同一个节拍），不是实测值。
# 这两个数来自单一出口、单日样本，换出口或换时段可能完全不同——所以它们是可调的。
MINT_DELAY_MIN_MS=60000
MINT_DELAY_MAX_MS=90000

# 单次铸 key 最多试几个域名。
#
# ⚠️ 从 8 改成 1。注册机现在会把「上游认不认这个域名」记下来复用，稳态下挑一个
# 已知能用的域名即可，**一次成功铸号只打一次发验证码请求**。
# 调大它会**等量放大每轮的限流预算消耗**：每多试一个域名就是多一次真实的发码请求，
# 而实测的预算大约是每个窗口 4~6 次。域名轮换并没有消失，只是搬到了两次铸 key
# 之间（那里本来就有上面那段间隔）。
MAX_DOMAIN_ATTEMPTS=1

# 铸出的 Agnes API key 在 Agnes 后台显示的名称
REGISTRAR_TOKEN_NAME=auto

# 注册、登录、铸 key 使用的 Agnes 平台后端地址（厂商公开端点）。
# ⚠️ 它是**注册凭据的去向**：改成别人的地址，等于把每次注册的邮箱 + 密码 + 验证码交出去。
AGNES_PLATFORM_URL=https://platform-backend.agnes-ai.com

# YYDS Mail 凭据（选中的通道为 yyds 时必填）
# 没选它也可以先填好，随时切过来 —— 面板上那条通道的「已配置」与「测试连接」都认这两格。
YYDS_BASE_URL=https://maliapi.215.im
YYDS_API_KEY=

# MoeMail 凭据（自建服务，无默认地址；选中的通道为 moemail 时两项都必填）
# 同样可以先填好再切过来。
MOEMAIL_BASE_URL=
MOEMAIL_API_KEY=

# ── 管理面板（未设置时整棵 /admin 树不注册，访问得到 404）─────────────────
# 管理口令。**必须与 GATEWAY_TOKEN 不同**，且至少 24 位：Worker 形态没有分布式
# 登录限速（做它要拿 KV 当窗口，等于给攻击者一根消耗写配额的杠杆），口令熵就是
# 唯一的防线。不满足这两条时面板不会启用（容器日志有 admin.token_rejected），
# 但网关转发完全不受影响。
#
# 另外首尾不得有空白：HTTP 请求头的值在传输层会被去掉首尾空白，而环境变量不会，
# 所以口令末尾多敲一个空格，任何客户端都送不出这个值——症状是「口令明明对却一直
# 401」。这条同样在启动时就拒绝并记 admin.token_rejected，不会让你对着看不见的空格排查。
#
# 「不得与 GATEWAY_TOKEN 相同」这条在启动时校验，**并且每个管理请求都复查一次**：
# 若两者在运行中变成相同（例如手工把 gatewayToken 写进了存储），管理接口立刻开始
# 返回 503 并记 admin.token_conflict，而网关转发照常。中转口令是发给每一个下游
# 用户的，复用它当面板口令等于把整池 key 交出去。
#
# 它**只从环境变量读、不从存储读**，面板不能自助轮换自己的钥匙。轮换方式：
# Worker 改 secret 后重新部署（wrangler secret put ADMIN_TOKEN）；Docker 改完这一行之后跑
# `docker compose up -d` 把容器**重建**掉——`docker compose restart` 不会重读 .env，
# 容器的环境是创建时固化的。这条坑在轮换上尤其贵：你以为旧口令已经失效，其实还在生效。
ADMIN_TOKEN=

# 只有你确实把网关放在代理后面时才设成 1——**Cloudflare Worker 形态也算，应当设上**。
# 这个开关决定的客户端 IP 会写进登录失败事件，无脑信任一个客户端能提供的头，等于
# 允许任何人把爆破痕迹嫁祸给别人。
#
# 不设时**任何转发头都不信**，该字段一律记 null，CF-Connecting-IP 也不例外：它「伪造
# 不了」这个性质只在请求真的经过 Cloudflare 时成立，Node/Docker 直连暴露时没人覆盖它，
# 客户端自己发一个就会被采信——而直连正是 Docker 部署的默认形态。
#
# 设了之后 CF-Connecting-IP 优先，缺席才退到 X-Forwarded-For 的首段：前者由 Cloudflare
# 边缘写入并覆盖客户端的同名头，后者是任何中间件都能追加的链、客户端可以自己造。
TRUST_PROXY=

# ── Tier-2 用量统计（默认关闭） ──────────────────────────────────
# 面板「用量」板块的时间序列（按天 / 按小时 / 按模型 / 按协议）。
# **默认关，而且「关」是零成本的**：关闭时不建任何内存累加器、一次存储写都没有。
#
# **判据是逐字的 true**（与 REGISTRAR_ENABLED 同一套）：写 1 / yes / on 都算关。
#
# 打开之后每天多写多少：**每个实例每天最多 13 次 put**（12 次落盘 + 跨 UTC 零点那次
# 多写的一个键），按 8 个并发 isolate 估算是 13 × 8 = 104 次/天，约占免费档
# 1,000 次/天写配额的 10.4%。这是一道**硬闸**：耗尽后当天不再写，下一个 UTC 日恢复。
# 默认关的理由是它与 key 池的状态回写抢同一个写桶——统计吃掉写配额会连带打死
# key 池的冷却与剔除记账。
#
# **两条代价，都是同一件事的两面**：落盘最小间隔是 2 小时，所以
# ① 面板上「今天」的数字最多旧 2 小时；
# ② 存活不足 2 小时的实例（Worker 短命 isolate、Docker 快速重启）攒的计数随实例消失。
#
# 改这个值要重启容器 / 等 isolate 回收才生效。**面板上没有这一格**：它不在面板能改的
# 字段里，只能改这里的环境变量（别照着那两个池子旋钮的说法去面板里找它）。
USAGE_STATS_ENABLED=false

# 两次落盘之间至少隔多久（毫秒）。默认 7200000（2 小时），**两种运行时的默认值相同**。
#
# 能不能调小，**取决于你的存储有没有写配额，而不是跑在哪个运行时上**：
# · 文件存储（Docker）没有写配额 ⇒ 任意正整数放行，而且不再有每天的写预算，
#   上界就是间隔本身。调成 300000（5 分钟）完全合理，面板会更实时。
# · KV（Cloudflare Worker）有写配额 ⇒ 每实例每天 13 次的预算不变，而间隔必须满足
#   间隔 × (13 − 1) >= 一天，破了在装配时就抛错并告诉你最小可用值（7200000）——但那条消息
#   在 Worker 上你看不到：wrangler deploy 照样成功，之后是每个请求一个不说原因的 500，
#   真正的原因只落在 console.error（要 wrangler tail 才看得到）。
#   这道校验与上面的 USAGE_STATS_ENABLED 开没开无关：src/http/wire.ts 无条件算一次落盘
#   间隔，所以把统计开关关回 false 并不能解除那场 500。
#   不默默接受是有意的：那种值下写量仍然合格，而数据从中午起就是假的。
#
# 只调大不需要理由；调大之后未落盘的尾巴跟着变长（面板「今天」的数字更旧）。
#
# ⚠️ **这一行默认是注释掉的，不是留空**，与本文件其余数值旋钮的写法看齐。
# 它曾经留过空：`cp .env.example .env` + docker compose 把留空的键当作**空字符串**
#（不是未设置）传进来，而 Number("") = 0 过不了「不小于 1 的整数」这一关 ⇒ 全新部署起不来。
# 今天 src/http/usage-sink.ts 的 resolveUsageFlushInterval 专门为它留了「空串等同没设」
# 的分支，而且是本仓唯一一条这样的分支——那里的原话是「唯一一个被喂给严格整数校验器的
# **空值项**」，照它的措辞来：**「空值项」不是「数值项」**——本文件里被喂给同一个校验器的
# 数值项不止它一个，只是那些没有这条分支。
# ⚠️ 所以**别照这一行的写法给别的数值项留空**：它们留空会当场抛错。
# USAGE_FLUSH_INTERVAL_MS=7200000

# ── 对外 API 密钥（面板「API 密钥」板块签发的那一族）─────────────────────────
#
# 密钥表在本实例的缓存有效期（毫秒）。默认 300000（5 分钟）。**0 = 关缓存**。
#
# 它决定两件事，方向相反，改之前两头都要看：
# ① **读配额**：有客户端拿子密钥来打网关时，每个活跃实例每天读 86400 ÷ (本值的秒数) 次。
#    默认值 ⇒ 288 次/实例/天。**一把子密钥都没签发过、或全部客户端都用 GATEWAY_TOKEN 时
#    是 0 次**——那条路径上根本没有刷新的调用点。
# ② **停用/删除多久生效**：在面板上停用一把密钥之后，别的实例最多还要
#    「本值 + KV 边缘缓存 60 秒」才看得见 ⇒ 默认约 6 分钟。**这是安全相关的**：
#    想让吊销更快就调小它，代价是 ① 那本读账等量放大。
#
# ⚠️ **这一行默认是注释掉的，不是留空。** 与上面 USAGE_FLUSH_INTERVAL_MS 那条同源，
# 但后果不同：那一条留空会**起不来**，这一条留空会 Number("") = 0 ⇒ 静默把缓存关掉，
# 读配额随请求数线性增长而没有任何报错。src/http/apikey-holder.ts 的
# resolveApiKeyCacheTtl 因此也留了「空串等同没设」的分支。
# APIKEY_CACHE_TTL_MS=300000
